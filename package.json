{
  "name": "smart-parking",
  "version": "0.0.1",
  "private": true,
  "description": "Smart Parking monorepo — mobile app, website, and shared packages",
  "scripts": {
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "typecheck:shared": "pnpm --filter @smart-parking/shared typecheck",
    "typecheck:mobile": "pnpm --filter smart-parking-mobile typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "ingest:sf-parking": "tsx scripts/ingest-sf-parking-data.ts",
    "ingest:sf-parking:meters": "tsx scripts/ingest-sf-parking-data.ts --meters-only --limit=100",
    "check:city-parking": "tsx scripts/check-city-parking-data.ts",
    "normalize:city-parking": "tsx scripts/normalize-city-parking.ts",
    "verify:normalized-parking": "tsx scripts/verify-normalized-parking.ts",
    "check:city-parking-service": "tsx scripts/check-city-parking-service.ts",
    "verify:legality-engine": "tsx scripts/verify-legality-engine.ts",
    "verify:orchestration": "tsx scripts/verify-orchestration.ts",
    "verify:schedule-parser": "tsx scripts/verify-schedule-parser.ts",
    "verify:schedule-applicability": "tsx scripts/verify-schedule-applicability.ts",
    "verify:regulation-association": "tsx scripts/verify-regulation-association.ts",
    "verify:regulation-coverage": "tsx scripts/verify-regulation-coverage.ts",
    "verify:legal-conclusion": "tsx scripts/verify-legal-conclusion.ts",
    "verify:parking-search": "tsx scripts/verify-parking-search.ts",
    "verify:mobile-parking-search": "tsx scripts/verify-mobile-parking-search.ts",
    "verify:regulation-storage": "tsx scripts/verify-regulation-storage.ts",
    "verify:datasf-retry": "tsx scripts/verify-datasf-retry.ts",
    "verify:curb-publication": "tsx scripts/verify-curb-publication-contract.ts",
    "verify:curb-publication-db": "tsx scripts/verify-curb-publication-db.ts",
    "verify:curb-lossless-db": "tsx scripts/verify-curb-lossless-db.ts",
    "verify:curb-db-eligibility": "tsx scripts/verify-curb-db-eligibility.ts",
    "verify:curb-staging-rpc": "tsx scripts/verify-curb-staging-rpc.ts",
    "verify:curb-v2-publication": "tsx scripts/verify-curb-v2-publication.ts",
    "verify:curb-archive": "tsx scripts/verify-curb-snapshot-archive.ts",
    "verify:curb-archive-tests": "tsx scripts/verify-curb-snapshot-archive-tests.ts",
    "verify:curb-artifact-store": "tsx scripts/verify-curb-artifact-store.ts",
    "verify:curb-artifact-recovery": "tsx scripts/verify-curb-artifact-recovery.ts",
    "verify:curb-artifact-cloud": "tsx scripts/verify-curb-artifact-cloud.ts",
    "verify:curb-s3-tests": "tsx scripts/verify-curb-s3-tests.ts",
    "profile:regulation-data": "tsx scripts/profile-regulation-data.ts",
    "profile:regulation-join": "tsx scripts/profile-regulation-join.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/node": "^22.10.0",
    "supabase": "^2.117.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.22.0"
}
